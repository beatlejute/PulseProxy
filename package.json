{
    "name": "pulse-proxy",
    "version": "1.3.0",
    "description": "PulseProxy VPN - browser proxy management",
    "type": "module",
    "scripts": {
        "build": "node esbuild.config.js",
        "watch": "node esbuild.config.js --watch",
        "clean": "rimraf dist",
        "type-check": "tsc --noEmit",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "package": "npm run build && node scripts/package.cjs",
        "update-proxies": "npx tsx scripts/update-proxies.ts"
    },
    "devDependencies": {
        "@types/chrome": "^0.1.36",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.3.0",
        "archiver": "^7.0.1",
        "esbuild": "^0.27.3",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.2.0",
        "jsdom": "^28.1.0",
        "rimraf": "^6.1.3",
        "ts-jest": "^29.4.6",
        "typescript": "^5.9.3"
    }
}
