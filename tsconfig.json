{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "declaration": false,
        "sourceMap": true,
        "lib": ["ES2020", "DOM"]
    },
    "include": ["src/**/*", "sources/**/*.ts", "scripts/update-proxies.ts"],
    "exclude": ["node_modules", "dist"]
}