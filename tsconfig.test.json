{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": ["jest", "node"],
        "rootDir": ".",
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"]
        },
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true
    },
    "include": ["tests/**/*", "src/**/*"]
}